---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import CategoryBadge from "@/components/CategoryBadge.astro";
import {
  CATEGORIES,
  CATEGORY_GROUPS,
  SERIES_ROADMAPS,
} from "@/data/categories";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const posts = getSortedPosts(await getCollection("posts"));
const counts = Object.fromEntries(
  CATEGORIES.map(category => [
    category.slug,
    posts.filter(post => post.data.category === category.slug).length,
  ])
);

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const weekdayGroups = CATEGORY_GROUPS.filter(group =>
  ["frontier", "harness", "classic-algorithms"].includes(group.id)
);
const archiveGroup = CATEGORY_GROUPS.find(
  group => group.id === "foundation-models"
);
const seriesGroups = CATEGORY_GROUPS.filter(group =>
  ["ml-classics", "training-methods"].includes(group.id)
);
---

<Layout title={`${t.pages.categoriesTitle} | ${config.site.title}`}>
  <Header />
  <Breadcrumb />

  <Main pageTitle={t.pages.categoriesTitle} pageDesc={t.pages.categoriesDesc}>
    <div class="space-y-10">
      <section>
        <div class="border-accent mb-5 border-s-4 ps-4">
          <p
            class="text-accent m-0 text-xs font-semibold tracking-[0.2em] uppercase"
          >
            Weekday signals
          </p>
          <h2 class="mt-1 mb-0 text-xl font-semibold">周内观察</h2>
        </div>

        <div class="grid gap-4 md:grid-cols-3">
          {
            weekdayGroups.map(group => (
              <article class="border-border bg-muted/20 flex min-h-72 flex-col rounded-2xl border p-5 transition-transform hover:-translate-y-1">
                <div class="mb-5 flex items-start justify-between gap-4">
                  <span
                    aria-hidden="true"
                    class="text-accent/30 text-4xl font-black tracking-tighter"
                  >
                    {group.number}
                  </span>
                  <span class="border-border text-muted-foreground rounded-full border px-2.5 py-1 text-xs">
                    {group.cadence}
                  </span>
                </div>
                <h3 class="mb-2 text-xl font-semibold">{group.label}</h3>
                <p class="text-muted-foreground mt-0 mb-6 text-sm leading-6">
                  {group.description}
                </p>
                <div class="mt-auto flex flex-wrap gap-2">
                  {group.categories.map(category => (
                    <CategoryBadge
                      category={category}
                      count={counts[category] ?? 0}
                    />
                  ))}
                </div>
              </article>
            ))
          }
        </div>
      </section>

      {
        archiveGroup && (
          <section class="border-accent/50 relative overflow-hidden rounded-2xl border border-dashed p-6 sm:p-8">
            <div
              aria-hidden="true"
              class="text-accent/5 pointer-events-none absolute -top-5 -right-2 text-7xl font-black tracking-tighter sm:text-8xl"
            >
              ARCHIVE
            </div>
            <div class="relative max-w-2xl">
              <p class="text-accent m-0 text-xs font-semibold tracking-[0.2em] uppercase">
                Long-term files
              </p>
              <div class="mt-2 mb-3 flex flex-wrap items-baseline gap-3">
                <span class="text-accent/40 text-3xl font-black tracking-tighter">
                  {archiveGroup.number}
                </span>
                <h2 class="text-xl font-semibold">{archiveGroup.label}</h2>
                <span class="text-muted-foreground text-sm">
                  {archiveGroup.cadence}
                </span>
              </div>
              <p class="text-muted-foreground mt-0 mb-5">
                {archiveGroup.description}
              </p>
              <div class="flex flex-wrap gap-3">
                {archiveGroup.categories.map(category => (
                  <CategoryBadge
                    category={category}
                    count={counts[category] ?? 0}
                    size="lg"
                  />
                ))}
              </div>
            </div>
          </section>
        )
      }

      <section>
        <div class="border-accent mb-5 border-s-4 ps-4">
          <p
            class="text-accent m-0 text-xs font-semibold tracking-[0.2em] uppercase"
          >
            Deep-dive series
          </p>
          <h2 class="mt-1 mb-0 text-xl font-semibold">系统学习</h2>
          <p
            class="text-muted-foreground mt-2 mb-0 max-w-3xl text-sm leading-6"
          >
            这两条线不追逐日更数量，而是按知识依赖逐篇展开：先解释问题和推导，再核对实验、实现细节与失效边界。
          </p>
        </div>

        <div class="grid gap-4 md:grid-cols-2">
          {
            seriesGroups.map(group => (
              <article class="border-border bg-muted/20 rounded-2xl border p-5 sm:p-6">
                <div class="mb-4 flex items-start justify-between gap-4">
                  <span class="text-accent/30 text-4xl font-black tracking-tighter">
                    {group.number}
                  </span>
                  <span class="border-border text-muted-foreground rounded-full border px-2.5 py-1 text-xs">
                    {group.cadence}
                  </span>
                </div>
                <h3 class="mb-2 text-xl font-semibold">{group.label}</h3>
                <p class="text-muted-foreground mt-0 mb-5 text-sm leading-6">
                  {group.description}
                </p>
                <div class="flex flex-wrap gap-2">
                  {group.categories.map(category => (
                    <CategoryBadge
                      category={category}
                      count={counts[category] ?? 0}
                      size="lg"
                    />
                  ))}
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section>
        <div class="border-accent mb-5 border-s-4 ps-4">
          <p
            class="text-accent m-0 text-xs font-semibold tracking-[0.2em] uppercase"
          >
            Roadmap
          </p>
          <h2 class="mt-1 mb-0 text-xl font-semibold">系列清单</h2>
        </div>

        <div class="grid items-start gap-5 lg:grid-cols-2">
          {
            SERIES_ROADMAPS.map(roadmap => (
              <article class="border-border rounded-2xl border p-5 sm:p-6">
                <div class="mb-3 flex items-baseline gap-3">
                  <span class="text-accent text-sm font-bold">
                    {roadmap.number}
                  </span>
                  <h3 class="m-0 text-xl font-semibold">{roadmap.label}</h3>
                </div>
                <p class="text-muted-foreground mt-0 mb-5 text-sm leading-6">
                  {roadmap.description}
                </p>
                <ol class="grid list-decimal gap-x-8 gap-y-2 ps-5 text-sm leading-6 sm:grid-cols-2">
                  {roadmap.items.map(item => (
                    <li class="ps-1">{item}</li>
                  ))}
                </ol>
              </article>
            ))
          }
        </div>
      </section>
    </div>
  </Main>

  <Footer />
</Layout>
