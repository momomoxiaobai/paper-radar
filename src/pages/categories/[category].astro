---
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import CategoryBadge from "@/components/CategoryBadge.astro";
import { CATEGORIES, type CategorySlug } from "@/data/categories";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

export async function getStaticPaths() {
  const posts = getSortedPosts(await getCollection("posts"));

  return CATEGORIES.map(category => ({
    params: { category: category.slug },
    props: {
      category,
      posts: posts.filter(post => post.data.category === category.slug),
    },
  }));
}

type Props = {
  category: (typeof CATEGORIES)[number];
  posts: CollectionEntry<"posts">[];
};

const { category, posts } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout title={`${category.label} | ${config.site.title}`}>
  <Header />
  <Breadcrumb />

  <Main
    pageTitle={`${t.pages.categoryTitle}: ${category.label}`}
    pageDesc={category.description}
  >
    <div class="border-border mb-8 flex flex-wrap gap-2 border-b pb-6">
      {
        CATEGORIES.map(item => (
          <CategoryBadge
            category={item.slug as CategorySlug}
            active={item.slug === category.slug}
          />
        ))
      }
    </div>

    {
      posts.length > 0 ? (
        <ul>
          {posts.map(post => (
            <Card {...post} />
          ))}
        </ul>
      ) : (
        <div class="border-border bg-muted/30 rounded-xl border p-6">
          <p class="m-0 font-medium">该分类正在建设中。</p>
          <p class="text-muted-foreground mt-2 mb-0 text-sm">
            自动发现任务已经开始收集相关论文，完成全文核验后会在这里发布解读。
          </p>
        </div>
      )
    }
  </Main>

  <Footer />
</Layout>
